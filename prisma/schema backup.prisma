generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["horas", "payroll", "public"]
}

model boleta {
  id              Int      @id(map: "boleta_pk") @default(autoincrement())
  fecha_inicio    String?  @db.VarChar
  proyecto        String?  @db.VarChar
  ubicacion       String?  @db.VarChar
  comentarios     String?  @db.VarChar
  cantidad_medida Int?
  unidad_medida   String?  @db.VarChar
  hora_inicio     String?  @db.VarChar
  hora_final      String?  @db.VarChar
  cerrada         Boolean?
  codigo_manobra  Int?
  fecha_final     String?  @db.VarChar

  @@schema("horas")
}

model empleado_boleta {
  id_boleta       Int
  codigo_empleado String  @db.VarChar
  fecha_inicio    String? @db.VarChar
  hora_inicio     String? @db.VarChar
  fecha_final     String? @db.VarChar
  hora_final      String? @db.VarChar
  id              Int     @id(map: "empleado_boleta_pk") @default(autoincrement())

  @@schema("horas")
}

model horas_tb_usuario {
  login             String   @id @db.VarChar
  nombre            String   @db.VarChar(30)
  password          String   @db.VarChar(8)
  fecha_cambio      DateTime @default(now()) @db.Timestamptz(6)
  fecha_vencimiento DateTime @default(now()) @db.Timestamptz(6)
  activo            Boolean

  @@map("tb_usuario")
  @@schema("horas")
}

model usuario {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(30)
  login    String @db.VarChar(30)
  password String @db.VarChar(30)
  perfil   String @db.VarChar(30)

  @@schema("horas")
}

model accionpersonal {
  idaccionpersonal      BigInt    @id
  activo                Boolean
  aplicada              Boolean
  codigo_empleado       String?   @db.VarChar(255)
  cuenta_bancaria       String?   @db.VarChar(255)
  desempeno             String?   @db.VarChar(255)
  fechacambio           DateTime? @db.Date
  fecha_exclusion       DateTime? @db.Date
  fecha_inclusion       DateTime? @db.Date
  fecha_ingreso         DateTime? @db.Date
  fecha_salida          DateTime? @db.Date
  fecha_salida_esperada DateTime? @db.Date
  forma_de_pago         Int?
  funcion               String?   @db.VarChar(255)
  idempleado            BigInt
  numero_transaccion    String?   @db.VarChar(255)
  observaciones         String?   @db.VarChar(255)
  salario               Float
  tipoaccionpersonal    String?   @db.VarChar(255)
  tipo_contrato         String?   @db.VarChar(255)
  tipo_cuenta           Int?
  banco_idbanco         BigInt?
  poliza_numero_poliza  String?   @db.VarChar(255)
  proyecto_presupuesto  BigInt?
  puesto_idpuesto       BigInt?
  poliza                poliza?   @relation(fields: [poliza_numero_poliza], references: [numero_poliza], onDelete: NoAction, onUpdate: NoAction, map: "fk_2tm07mhi7wcska8m1xotswha3")
  proyecto              proyecto? @relation(fields: [proyecto_presupuesto], references: [presupuesto], onDelete: NoAction, onUpdate: NoAction, map: "fk_89v6r1d013i6j35pbeaigyg5a")
  puesto                puesto?   @relation(fields: [puesto_idpuesto], references: [idpuesto], onDelete: NoAction, onUpdate: NoAction, map: "fk_8phfbdb3p49va7a53icl8bdwf")
  banco                 banco?    @relation(fields: [banco_idbanco], references: [idbanco], onDelete: NoAction, onUpdate: NoAction, map: "fk_gbv31j1qp7mu4iai2l80a0d3j")

  @@schema("payroll")
}

model asistencia {
