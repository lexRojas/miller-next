generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["horas", "payroll", "public"]
}

model boleta {
  id              Int      @id(map: "boleta_pk") @default(autoincrement())
  fecha_inicio    String?  @db.VarChar
  proyecto        String?  @db.VarChar
  ubicacion       String?  @db.VarChar
  comentarios     String?  @db.VarChar
  cantidad_medida Int?
  unidad_medida   String?  @db.VarChar
  hora_inicio     String?  @db.VarChar
  hora_final      String?  @db.VarChar
  cerrada         Boolean?
  codigo_manobra  Int?
  fecha_final     String?  @db.VarChar

  @@schema("horas")
}

model empleado_boleta {
  id_boleta       Int
  codigo_empleado String  @db.VarChar
  fecha_inicio    String? @db.VarChar
  hora_inicio     String? @db.VarChar
  fecha_final     String? @db.VarChar
  hora_final      String? @db.VarChar
  id              Int     @id(map: "empleado_boleta_pk") @default(autoincrement())

  @@schema("horas")
}

model horas_tb_usuario {
  login             String   @id @db.VarChar
  nombre            String   @db.VarChar(30)
  password          String   @db.VarChar(8)
  fecha_cambio      DateTime @default(now()) @db.Timestamptz(6)
  fecha_vencimiento DateTime @default(now()) @db.Timestamptz(6)
  activo            Boolean

  @@map("tb_usuario")
  @@schema("horas")
}

model usuario {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(30)
  login    String @db.VarChar(30)
  password String @db.VarChar(30)
  perfil   String @db.VarChar(30)

  @@schema("horas")
}

model empleado {
  idempleado                BigInt             @id
  activo                    Boolean
  codigo_empleado           String?            @db.VarChar(255)
  cuenta_bancaria           String?            @db.VarChar(255)
  desempeno                 String?            @db.VarChar(255)
  fecha_exclusion           DateTime?          @db.Date
  fecha_inclusion           DateTime?          @db.Date
  fecha_ingreso             DateTime?          @db.Date
  fecha_salida              DateTime?          @db.Date
  fecha_salida_esperada     DateTime?          @db.Date
  forma_de_pago             Int?
  funcion                   String?            @db.VarChar(255)
  numero_transaccion        String?            @db.VarChar(255)
  salario                   Float
  tipo_contrato             String?            @db.VarChar(255)
  tipo_cuenta               Int?
  banco_idbanco             BigInt?
  persona_idpersona         BigInt?
  poliza_numero_poliza      String?            @db.VarChar(255)
  proyecto_presupuesto      BigInt?
  puesto_idpuesto           BigInt?
  terminacion_idterminacion BigInt?
  proyecto                  proyecto?          @relation(fields: [proyecto_presupuesto], references: [presupuesto], onDelete: NoAction, onUpdate: NoAction, map: "fk_dy2rcv2a58uatciosi4w816ox")
  puesto                    puesto?            @relation(fields: [puesto_idpuesto], references: [idpuesto], onDelete: NoAction, onUpdate: NoAction, map: "fk_iptmdwyul48x4mcf946tvjrr7")
  persona                   persona?           @relation(fields: [persona_idpersona], references: [idpersona], onDelete: NoAction, onUpdate: NoAction, map: "fk_qcy6jhjmsrooj404ooo2tgo2u")
  persona_empleado          persona_empleado?

  @@schema("payroll")
}

model persona {
  idpersona                    BigInt             @id
  apellido1                    String?            @db.VarChar(255)
  apellido2                    String?            @db.VarChar(255)
  condicion                    String?            @db.VarChar(255)
  direccion                    String?            @db.VarChar(255)
  fecha_nacimiento             DateTime?          @db.Date
  genero                       String?            @db.VarChar(255)
  nombre1                      String?            @db.VarChar(255)
  nombre2                      String?            @db.VarChar(255)
  nombre_completo              String?            @db.VarChar(255)
  telefono                     String?            @db.VarChar(255)
  tipoasegurado                Int?
  estado_civil_idestado_civil1 BigInt?
  nacionalidad_id_nacionalidad BigInt?
  empleado                     empleado[]
  persona_empleado             persona_empleado[]

  @@schema("payroll")
}

model persona_empleado {
  persona_idpersona     BigInt
  empleadoes_idempleado BigInt   @unique(map: "uk_atrubewuu6ip6nwf9ty1rn8ee")
  persona               persona  @relation(fields: [persona_idpersona], references: [idpersona], onDelete: NoAction, onUpdate: NoAction, map: "fk_29wb6pmokewe2q7tiq940sk2l")
  empleado              empleado @relation(fields: [empleadoes_idempleado], references: [idempleado], onDelete: NoAction, onUpdate: NoAction, map: "fk_atrubewuu6ip6nwf9ty1rn8ee")

  @@schema("payroll")
}

model proyecto {
  presupuesto BigInt     @id
  proyecto    String?    @db.VarChar(255)
  empleado    empleado[]

  @@schema("payroll")
}

model puesto {
  idpuesto    BigInt     @id
  descripcion String?    @db.VarChar(255)
  estado      Boolean?
  empleado    empleado[]

  @@schema("payroll")
}

